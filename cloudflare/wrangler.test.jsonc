{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "shuokai-supabase-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "minify": true,
  "vars": {
    "APP_ENVIRONMENT": "test"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "../miniapp/dist/build/h5",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/health*",
      "/wechat-login*",
      "/miniapp-api*",
      "/room/invitation-context*",
      "/ai/expression*",
      "/ai/clarify*",
      "/ai/understanding*",
      "/transcribe*"
    ]
  },
  "queues": {
    "producers": [
      { "binding": "AI_JOBS_QUEUE", "queue": "shuokai-ai-jobs-test" }
    ],
    "consumers": [
      {
        "queue": "shuokai-ai-jobs-test",
        "dead_letter_queue": "shuokai-ai-jobs-test-dlq",
        "max_batch_size": 5,
        "max_concurrency": 3,
        "max_retries": 3
      }
    ]
  }
}
