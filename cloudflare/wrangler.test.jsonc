{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "shuokai-supabase-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "minify": true,
  "assets": {
    "directory": "../miniapp/dist/build/h5",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/health*",
      "/wechat-login*",
      "/miniapp-api*",
      "/transcribe*"
    ]
  }
}
