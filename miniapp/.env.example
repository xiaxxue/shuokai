# Copy to miniapp/.env.local for an H5 test build.
SHUOKAI_API_BASE_URL=https://your-test-worker.example.com
SHUOKAI_WECHAT_APP_ID=wx_replace_with_real_appid
SHUOKAI_WECHAT_CLOUD_ENV=your-test-cloud-environment-id
SHUOKAI_SUPABASE_URL=https://your-project-ref.supabase.co
SHUOKAI_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# WeChat uses wx.cloud.callFunction; set SHUOKAI_WECHAT_CLOUD_ENV.
# SHUOKAI_API_BASE_URL is only used by H5.
# Supabase URL/key are not used by the mp-weixin client.
