# Copy to miniapp/.env.local for a real H5 test build.
SHUOKAI_API_MODE=live
SHUOKAI_API_BASE_URL=https://your-test-worker.example.com
SHUOKAI_SUPABASE_URL=https://your-project-ref.supabase.co
SHUOKAI_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# For a WeChat build, keep SHUOKAI_API_MODE=live and SHUOKAI_API_BASE_URL.
# Supabase URL/key are not used by the mp-weixin client.
