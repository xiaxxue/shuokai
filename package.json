{
  "name": "shuokai-prototype",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "miniapp:dev": "npm --prefix miniapp run dev:mp-weixin",
    "miniapp:build": "npm --prefix miniapp run build:mp-weixin",
    "miniapp:build:h5": "npm --prefix miniapp run build:h5",
    "miniapp:type-check": "npm --prefix miniapp run type-check",
    "miniapp:test": "npm --prefix miniapp test",
    "cloudflare:test": "node --test cloudflare/tests/*.test.ts",
    "cloudflare:type-check": "tsc --project cloudflare/tsconfig.json",
    "cloudflare:dry-run": "npm run miniapp:build:h5 && WRANGLER_WRITE_LOGS=false WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler deploy --dry-run --config cloudflare/wrangler.jsonc",
    "cloudflare:dev": "npm run miniapp:build:h5 && WRANGLER_WRITE_LOGS=false WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler dev --config cloudflare/wrangler.jsonc",
    "cloudflare:deploy": "SHUOKAI_API_MODE=live npm run miniapp:build:h5 && WRANGLER_WRITE_LOGS=false WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler deploy --config cloudflare/wrangler.jsonc",
    "test:web": "npm run build && node --test tests/rendered-html.test.mjs",
    "test": "npm run test:web && npm run miniapp:test && npm run cloudflare:test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.1",
    "next": "16.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "react-server-dom-webpack": "19.2.6",
    "supabase": "2.111.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
